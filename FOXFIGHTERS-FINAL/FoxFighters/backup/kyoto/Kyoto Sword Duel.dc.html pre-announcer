<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="_ds/modernist-ae67aa6b-5da8-44ce-9255-829f1d75925f/styles.css">
<script src="_ds/modernist-ae67aa6b-5da8-44ce-9255-829f1d75925f/_ds_bundle.js"></script>
<style>html,body{margin:0;height:100%;overflow:hidden;background:#000}a{color:#ffd23a}a:hover{color:var(--color-accent)}button:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}</style>
</helmet>
<div style="position:relative;width:100%;height:100vh;height:100dvh;overflow:hidden;background:#000;color:#fff;font-family:var(--font-body);user-select:none;-webkit-user-select:none;touch-action:none" data-screen-label="Kyoto Sword Duel">
  <div ref="{{ stageRef }}" style="position:absolute;left:0;right:0;top:{{ stageTop }};bottom:0;overflow:hidden"></div>
  <div style="position:absolute;inset:0;pointer-events:none;background:#fff;opacity:{{ whiteOp }};z-index:1"></div>
  <sc-if value="{{ lockOn }}" hint-placeholder-val="{{ false }}"><div onPointerDown="{{ lockTap }}" aria-label="Tap fast to win the blade lock" style="position:absolute;inset:0;pointer-events:auto;touch-action:none;cursor:pointer"></div></sc-if>
  <sc-if value="{{ cineOn }}" hint-placeholder-val="{{ false }}"><div onPointerDown="{{ cineTap }}" aria-label="Tap to skip" style="position:absolute;inset:0;pointer-events:auto;touch-action:none;cursor:pointer"></div></sc-if>
  <div data-hud-host="1" style="position:absolute;inset:0;pointer-events:none"><dc-import name="Game HUD" game="{{ engine }}" hud="{{ stdHud }}" started="{{ started }}" busy="{{ busy }}" on-hud="{{ onHud }}" world="{{ hudWorld }}" vehicle="duel" keys="{{ keysList }}" skip-keys="{{ skipKeys }}" hint-size="100%,100%" style="position:absolute;inset:0;pointer-events:none"></dc-import></div>
  <sc-if value="{{ barsOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:max(10px, env(safe-area-inset-left));right:max(10px, env(safe-area-inset-right));top:{{ cardTop }};z-index:2;pointer-events:none;display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:8px;align-items:start">
      <div style="background:#000;border:2px solid #3a3836;display:flex;flex-direction:column;min-width:0">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:6px;padding:3px 8px 2px"><span style="font:900 12px var(--font-heading);white-space:nowrap">{{ nameL }}</span><span style="display:flex;gap:3px"><sc-for list="{{ pipsB }}" as="p" hint-placeholder-count="2"><span style="width:9px;height:9px;border:2px solid #ffd23a;background:{{ p.c }};display:block"></span></sc-for></span></div>
        <div style="height:10px;margin:0 8px;background:#3a3836;position:relative"><span style="position:absolute;left:0;top:0;bottom:0;width:{{ lagB }};background:#f87171;display:block"></span><span style="position:absolute;left:0;top:0;bottom:0;width:{{ hpB }};background:{{ hpBC }};display:block"></span></div>
        <div style="height:5px;margin:4px 8px 6px;background:#2a2826;position:relative"><span style="position:absolute;left:0;top:0;bottom:0;width:{{ powB }};background:{{ powBC }};display:block"></span></div>
      </div>
      <div style="min-width:52px;background:#000;border:2px solid #ffd23a;display:flex;flex-direction:column;align-items:center;padding:2px 8px 4px"><span style="font:800 8px var(--font-heading);letter-spacing:0.12em;color:#ffd23a">R{{ h.round }}</span><span style="font:900 22px var(--font-heading);line-height:1;font-variant-numeric:tabular-nums">{{ h.timer }}</span></div>
      <div style="background:#000;border:2px solid #3a3836;display:flex;flex-direction:column;min-width:0">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:6px;padding:3px 8px 2px;flex-direction:row-reverse"><span style="font:900 12px var(--font-heading);white-space:nowrap">{{ nameR }}</span><span style="display:flex;gap:3px"><sc-for list="{{ pipsO }}" as="p" hint-placeholder-count="2"><span style="width:9px;height:9px;border:2px solid #ffd23a;background:{{ p.c }};display:block"></span></sc-for></span></div>
        <div style="height:10px;margin:0 8px;background:#3a3836;position:relative"><span style="position:absolute;right:0;top:0;bottom:0;width:{{ lagO }};background:#fbbf24;display:block"></span><span style="position:absolute;right:0;top:0;bottom:0;width:{{ hpO }};background:{{ hpOC }};display:block"></span><sc-if value="{{ bossTick }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;right:50%;top:-2px;bottom:-2px;width:2px;background:#ffd23a;display:block"></span></sc-if><sc-if value="{{ pearlTicks }}" hint-placeholder-val="{{ false }}"><span style="position:absolute;right:60%;top:-2px;bottom:-2px;width:2px;background:#ffd23a;display:block"></span><span style="position:absolute;right:30%;top:-2px;bottom:-2px;width:2px;background:#ffd23a;display:block"></span></sc-if></div>
        <div style="height:5px;margin:4px 8px 6px;background:#2a2826;position:relative;display:flex;justify-content:flex-end"><span style="height:100%;width:{{ powO }};background:#8a847e;display:block"></span></div>
      </div>
    </div>
  </sc-if>
  <sc-if value="{{ lockOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;transform:translateX(-50%);top:{{ lockTop }};z-index:4;pointer-events:none;width:min(320px, calc(100% - 24px));background:#000;border:2px solid #ffd23a;display:flex;flex-direction:column;box-sizing:border-box">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:5px 10px 4px"><span style="font:900 15px var(--font-heading);letter-spacing:0.06em;white-space:nowrap">BLADES LOCKED</span><span style="font:800 10px var(--font-heading);letter-spacing:0.1em;color:#ffd23a;white-space:nowrap">{{ lockHint }}</span></div>
      <div style="height:14px;margin:0 10px;display:flex;position:relative;background:#ec3013"><span style="display:block;height:100%;width:{{ lockW }};background:#38bdf8"></span><span style="position:absolute;top:-3px;bottom:-3px;left:{{ lockW }};width:4px;margin-left:-2px;background:#fff;display:block"></span><span style="position:absolute;top:0;bottom:0;left:50%;width:2px;margin-left:-1px;background:#000;display:block"></span></div>
      <div style="display:flex;justify-content:space-between;padding:3px 10px 0;font:800 9px var(--font-heading);letter-spacing:0.1em;gap:8px;white-space:nowrap"><span>{{ nameL }}</span><span>{{ nameR }}</span></div>
      <div style="height:4px;margin:4px 10px 7px;background:#2a2826"><span style="display:block;height:100%;width:{{ lockLeft }};background:#8a847e"></span></div>
    </div>
  </sc-if>
  <sc-if value="{{ pracOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:max(10px, env(safe-area-inset-left));right:max(10px, env(safe-area-inset-right));top:{{ pracTop }};z-index:5;pointer-events:none;display:flex;flex-direction:column;align-items:center;gap:4px">
      <div style="pointer-events:auto;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) minmax(0,0.8fr) minmax(0,0.8fr);width:min(460px,100%);background:#000;border:2px solid #3a3836">
        <button onClick="{{ pracDummy }}" style="min-height:44px;padding:2px 10px;border:0;border-radius:0;background:#000;color:#fff;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:1px;min-width:0" style-hover="background:#2a2826"><span style="font:800 8px var(--font-heading);letter-spacing:0.12em;color:#8a847e">DUMMY · TAP TO CHANGE</span><span style="font:900 13px var(--font-heading);letter-spacing:0.06em;color:#ffd23a;white-space:nowrap">{{ pracDummyName }}</span></button>
        <button onClick="{{ movesOpen }}" style="min-height:44px;padding:2px 10px;border:0;border-left:2px solid #3a3836;border-radius:0;background:#000;color:#fff;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:1px;min-width:0" style-hover="background:#2a2826"><span style="font:800 8px var(--font-heading);letter-spacing:0.12em;color:#8a847e;white-space:nowrap">MOVES TRIED</span><span style="font:900 13px var(--font-heading);letter-spacing:0.06em;white-space:nowrap;font-variant-numeric:tabular-nums">{{ movesTried }}</span></button>
        <button onClick="{{ pracReset }}" style="min-height:44px;padding:0 10px;border:0;border-left:2px solid #3a3836;border-radius:0;background:#000;color:#fff;font:900 11px var(--font-heading);letter-spacing:0.08em;cursor:pointer;text-align:left" style-hover="background:#2a2826">RESET</button>
        <button onClick="{{ toIntro }}" style="min-height:44px;padding:0 10px;border:0;border-left:2px solid #3a3836;border-radius:0;background:#ec3013;color:#fff;font:900 11px var(--font-heading);letter-spacing:0.08em;cursor:pointer;text-align:left" style-hover="background:#c82a10">EXIT</button>
      </div>
      <div style="display:flex;gap:2px;background:#000;border:2px solid #3a3836;font:800 10px var(--font-heading);letter-spacing:0.1em;font-variant-numeric:tabular-nums;white-space:nowrap"><span style="padding:3px 8px">LAST <span style="color:#ffd23a">{{ pracLast }}</span></span><span style="padding:3px 8px;border-left:2px solid #2a2826">COMBO <span style="color:#ffd23a">{{ pracCd }}</span></span><span style="padding:3px 8px;border-left:2px solid #2a2826">BEST <span style="color:#ffd23a">{{ pracBest }}</span></span></div>
    </div>
  </sc-if>
  <sc-if value="{{ movesOn }}" hint-placeholder-val="{{ false }}">
    <div onClick="{{ movesClose }}" style="position:absolute;inset:0;z-index:9;background:rgba(0,0,0,0.6);display:flex;align-items:flex-end;justify-content:flex-start;padding:max(12px, env(safe-area-inset-left));box-sizing:border-box">
      <div onClick="{{ stop }}" style="background:#000;border:2px solid #3a3836;width:min(520px,100%);max-height:calc(100% - {{ introTopGap }});display:flex;flex-direction:column;box-sizing:border-box">
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #3a3836"><div style="padding:10px 14px 8px;display:flex;flex-direction:column;gap:2px;min-width:0"><span style="font:900 22px var(--font-heading);line-height:1">Move list</span><span style="font:800 10px var(--font-heading);letter-spacing:0.1em;color:#ffd23a;white-space:nowrap">{{ movesKick }}</span></div><button onClick="{{ movesClose }}" aria-label="Close the move list" style="align-self:stretch;min-width:52px;min-height:52px;padding:0 14px;border:0;border-left:2px solid #3a3836;border-radius:0;background:#000;color:#fff;font:900 18px var(--font-heading);cursor:pointer;text-align:left" style-hover="background:#2a2826">✕</button></div>
        <div style="overflow-y:auto;min-height:0">
          <sc-for list="{{ moveRows }}" as="m" hint-placeholder-count="11">
            <div style="display:grid;grid-template-columns:22px minmax(0,1fr) minmax(0,auto);gap:10px;align-items:start;padding:8px 14px;border-bottom:2px solid #2a2826">
              <span style="font:900 14px var(--font-heading);color:{{ m.chkC }};line-height:1.2">{{ m.chk }}</span>
              <span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span style="font:900 14px var(--font-heading);letter-spacing:0.04em">{{ m.name }}</span><span style="font:500 13px var(--font-body);line-height:1.35;color:#cfcac2;text-wrap:pretty">{{ m.note }}</span></span>
              <span style="font:800 11px var(--font-heading);letter-spacing:0.06em;color:#ffd23a;text-align:right;max-width:150px;line-height:1.3;text-wrap:pretty">{{ m.input }}</span>
            </div>
          </sc-for>
        </div>
      </div>
    </div>
  </sc-if>
  <sc-if value="{{ boxOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:0;right:0;top:0;height:{{ boxH }};background:#000;z-index:3;pointer-events:none"></div>
    <div style="position:absolute;left:0;right:0;bottom:0;height:{{ boxH }};background:#000;z-index:3;pointer-events:none"></div>
  </sc-if>
  <sc-if value="{{ replayOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:max(14px, env(safe-area-inset-left));top:calc({{ boxH }} + {{ stageTop }} + 10px);z-index:4;pointer-events:none;display:flex;align-items:center;gap:8px;background:#000;border:2px solid #ec3013;padding:4px 10px"><span style="width:10px;height:10px;background:#ec3013;display:block"></span><span style="font:900 14px var(--font-heading);letter-spacing:0.14em">REPLAY</span></div>
  </sc-if>
  <sc-if value="{{ skipOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;transform:translateX(-50%);bottom:calc({{ boxH }} + {{ skipB }});z-index:4;pointer-events:none;background:{{ skipBg }};color:{{ skipFg }};border:2px solid #ffd23a;padding:6px 14px;font:900 12px var(--font-heading);letter-spacing:0.12em;white-space:nowrap">{{ skipTxt }}</div>
  </sc-if>
  <sc-if value="{{ callOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;top:{{ callTop }};transform:translate(-50%,-50%) scale({{ callScale }});opacity:{{ callOp }};z-index:4;pointer-events:none;font:900 {{ callFs }} var(--font-heading);letter-spacing:0.04em;color:#fff;-webkit-text-stroke:2px #000;text-shadow:0 4px 0 #ec3013;white-space:nowrap">{{ h.call }}</div>
  </sc-if>
  <sc-if value="{{ flashOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;{{ flashSide }}:max(12px, env(safe-area-inset-left));top:{{ flashTop }};z-index:4;pointer-events:none;background:rgba(0,0,0,0.85);border:2px solid {{ flashCol }};display:flex;align-items:stretch"><span style="flex:none;width:8px;background:{{ flashCol }};display:block"></span><span style="padding:4px 12px;font:900 {{ flashFs }} var(--font-heading);letter-spacing:0.03em;white-space:nowrap">{{ flashTxt }}</span></div>
  </sc-if>
  <sc-if value="{{ comboOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;{{ comboSide }}:max(14px, env(safe-area-inset-left));top:{{ comboTop }};z-index:4;pointer-events:none;display:flex;flex-direction:column;align-items:{{ comboAlign }};line-height:0.9"><span style="font:900 {{ comboFs }} var(--font-heading);color:#ffd23a;-webkit-text-stroke:2px #000;font-variant-numeric:tabular-nums">{{ comboN }}</span><span style="font:900 13px var(--font-heading);letter-spacing:0.14em;color:#fff;-webkit-text-stroke:1px #000">HITS</span></div>
  </sc-if>
  <sc-if value="{{ powOn }}" hint-placeholder-val="{{ false }}">
    <div style="position:absolute;left:50%;transform:translateX(-50%);bottom:{{ powHintB }};z-index:4;pointer-events:none;background:#ffd23a;color:#000;padding:4px 12px;font:900 12px var(--font-heading);letter-spacing:0.08em;white-space:nowrap">POWER FULL · {{ powKeys }}</div>
  </sc-if>
  <sc-if value="{{ demoOn }}" hint-placeholder-val="{{ false }}">
    <button onClick="{{ demoExit }}" aria-label="Exit the demo" style="position:absolute;right:max(12px, env(safe-area-inset-right));bottom:calc(200px + env(safe-area-inset-bottom));z-index:7;min-width:96px;min-height:48px;padding:0 14px;border:2px solid #ec3013;border-radius:0;background:#ec3013;color:#fff;font:900 12px var(--font-heading);letter-spacing:0.1em;cursor:pointer;text-align:left" style-hover="background:#c82a10">EXIT DEMO</button>
  </sc-if>
  <sc-if value="{{ introOn }}" hint-placeholder-val="{{ true }}">
    <div ref="{{ introRef }}" style="position:absolute;left:max(12px, env(safe-area-inset-left));bottom:calc(12px + env(safe-area-inset-bottom));z-index:6;width:{{ introW }};max-height:calc(100% - {{ introTopGap }});overflow-y:auto;background:#000;border:2px solid #3a3836;display:flex;flex-direction:column;box-sizing:border-box">
      <div style="padding:10px 14px 8px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:2px solid #3a3836"><span style="font:900 24px var(--font-heading);line-height:1;white-space:nowrap">Duel</span><button onClick="{{ movesOpen }}" style="min-height:44px;margin:-10px -14px -8px 0;padding:0 14px;border:0;border-left:2px solid #3a3836;border-radius:0;background:#000;color:#ffd23a;font:900 11px var(--font-heading);letter-spacing:0.1em;cursor:pointer;text-align:left" style-hover="background:#2a2826">MOVE LIST</button></div>
      <sc-if value="{{ introTip }}" hint-placeholder-val="{{ false }}"><span style="padding:8px 14px;border-bottom:2px solid #3a3836;font:700 13px var(--font-body);line-height:1.4;color:#cfcac2;text-wrap:pretty">1 · 2 · 3 attack. Back to guard, up to jump. Mash for slaps.</span></sc-if>
      <div style="display:grid;grid-template-columns:{{ introGrid }};flex:none">
        <div style="display:flex;flex-direction:column;min-width:0;border-right:{{ youBorder }}">
          <span style="padding:6px 14px 4px;font:800 10px var(--font-heading);letter-spacing:0.12em;color:#8a847e">YOU</span>
          <div style="display:grid;grid-template-columns:{{ youGrid }}">
            <sc-for list="{{ youRows }}" as="r" hint-placeholder-count="2">
              <button onClick="{{ r.go }}" aria-pressed="{{ r.pressed }}" style="min-height:48px;padding:6px 12px 6px 14px;border:0;border-top:2px solid #2a2826;border-radius:0;background:{{ r.bg }};color:{{ r.fg }};cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:2px;box-shadow:inset 6px 0 0 {{ r.bar }}" style-hover="filter:brightness(1.15)"><span style="font:900 13px var(--font-heading);letter-spacing:0.05em;white-space:nowrap">{{ r.name }}</span><span style="font:800 9px var(--font-heading);letter-spacing:0.08em;opacity:0.75;white-space:nowrap">{{ r.sub }}</span></button>
            </sc-for>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;min-width:0">
          <span style="padding:6px 14px 4px;font:800 10px var(--font-heading);letter-spacing:0.12em;color:#8a847e">OPPONENT</span>
          <sc-for list="{{ oppRows }}" as="r" hint-placeholder-count="5">
            <button onClick="{{ r.go }}" aria-pressed="{{ r.pressed }}" style="min-height:44px;padding:4px 12px 4px 14px;border:0;border-top:2px solid #2a2826;border-radius:0;background:{{ r.bg }};color:{{ r.fg }};cursor:pointer;text-align:left;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;box-shadow:inset 6px 0 0 {{ r.bar }}" style-hover="filter:brightness(1.15)"><span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span style="font:900 13px var(--font-heading);letter-spacing:0.05em;white-space:nowrap">{{ r.name }}</span><span style="font:800 9px var(--font-heading);letter-spacing:0.08em;opacity:0.75;white-space:nowrap">{{ r.sub }}</span></span><span style="font:900 9px var(--font-heading);letter-spacing:0.1em;color:{{ r.beatC }}">{{ r.beat }}</span></button>
          </sc-for>
        </div>
      </div>
      <span style="flex:none;padding:6px 14px 4px;border-top:2px solid #3a3836;font:800 10px var(--font-heading);letter-spacing:0.12em;color:#8a847e">STAGE</span>
      <div style="flex:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))">
        <sc-for list="{{ stageRows }}" as="r" hint-placeholder-count="4">
          <button onClick="{{ r.go }}" aria-pressed="{{ r.pressed }}" style="min-height:44px;padding:4px 6px 4px 10px;border:0;border-top:2px solid #2a2826;border-radius:0;background:{{ r.bg }};color:{{ r.fg }};cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:1px;min-width:0;box-shadow:inset 4px 0 0 {{ r.bar }}" style-hover="filter:brightness(1.15)"><span style="font:900 11px var(--font-heading);letter-spacing:0.05em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ r.name }}</span><span style="font:800 8px var(--font-heading);letter-spacing:0.08em;opacity:0.75;white-space:nowrap">{{ r.sub }}</span></button>
        </sc-for>
      </div>
      <div style="flex:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:2px solid #3a3836">
      <button onClick="{{ goStory }}" style="min-height:52px;padding:4px 8px 4px 12px;border:0;border-right:2px solid #3a3836;border-radius:0;background:#000;color:#fff;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0" style-hover="background:#2a2826"><span style="font:900 13px var(--font-heading);letter-spacing:0.06em;color:#ffd23a">STORY</span><span style="font:800 9px var(--font-heading);letter-spacing:0.08em;opacity:0.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">THE SECOND</span><span style="font:900 8px var(--font-heading);letter-spacing:0.1em;color:{{ storyTagC }};min-height:9px">{{ storyTag }}</span></button>
      <button onClick="{{ goLadder }}" style="min-height:52px;padding:4px 8px 4px 12px;border:0;border-right:2px solid #3a3836;border-radius:0;background:#000;color:#fff;cursor:pointer;text-align:left;display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0" style-hover="background:#2a2826"><span style="font:900 13px var(--font-heading);letter-spacing:0.06em;color:#ffd23a">LADDER</span><span style="font:800 9px var(--font-heading);letter-spacing:0.08em;opacity:0.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">5 + BOSS</span><span style="font:900 8px var(--font-heading);letter-spacing:0.1em;color:{{ ladTagC }};min-height:9px">{{ ladTag }}</span></button>
